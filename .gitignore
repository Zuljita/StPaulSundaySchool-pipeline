# Build output and scratch belong with the data, not here.
dist/
dist-draft/
build/
# The staged site bucket. It holds rendered curriculum, so it must never
# be committable here even when the data root falls back to this checkout.
dist-site/

__pycache__/
*.pyc
.venv/
venv/
node_modules/

# Wrangler's local cache. tools/publish_r2.py runs `npx wrangler` from
# this checkout, so a publish creates this directory here. Untracked, it
# makes `git status --porcelain` non-empty, which trips "Leave no
# curriculum behind" and fails the job after the upload has already
# succeeded. That guard exists to catch curriculum landing in a public
# repository; it cannot do that job if it reports a wrangler cache on
# every single publish.
.wrangler/
.DS_Store
Thumbs.db

# Never. The signing key lives in the service's secret store.
*.pem
approval-key*
